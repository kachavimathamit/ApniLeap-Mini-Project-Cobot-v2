# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=apnileap_portfolio
PGUSER=postgres
PGPASSWORD=postgres

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Jira / Confluence
# JIRA_BASE_URL / CONFLUENCE_BASE_URL: your Atlassian site, e.g. https://yoursite.atlassian.net
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=
